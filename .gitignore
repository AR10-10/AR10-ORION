# Cofre de credenciais — gerado por build_skills_and_data.py, nunca versionar
config/encrypted_credentials.env

# Caches da camada física de dados (apenas a árvore é versionada via .gitkeep)
data/feature_store/*
data/raw_ticks_cache/*
data/episodic_memory_cache/*
!data/*/.gitkeep

# Artefatos Python
__pycache__/
*.pyc

# Ambiente virtual local
.venv/

# Build cache do crate Rust -> WASM do iPad Runtime (binario final fica versionado em wasm/)
ipad_runtime/wasm-src/cyborg_quant_core/target/

# Cyborg PRO UI (React/Vite) — dependencias e build output sao gerados pelo
# workflow de deploy (npm ci && npm run build); so' o codigo-fonte e' versionado.
ipad_runtime/cyborgpro-ui/node_modules/
ipad_runtime/cyborgpro-ui/dist/
